# Nginx — Configuración de producción del Sistema de Apoyo a la Crianza.
#
# Dos responsabilidades:
#   1. /api/*  → PHP-FPM (Laravel) via FastCGI
#   2. /*      → Archivos estáticos del build de React
#
# Para activar HTTPS: obtené el certificado con certbot y descomentá el
# segundo bloque server. Ver instrucciones en deploy.sh.

# ─── HTTP → HTTPS redirect (activar después de tener certificado) ──────────
 server {
     listen 80;
     server_name sistemaapoyoalacrianza.cloud;
     return 301 https://$host$request_uri;
 }

# ─── Servidor principal ────────────────────────────────────────────────────
server {
    listen 80;

    # Después de obtener el certificado SSL, reemplazar las dos líneas
    # de arriba por estas (y descomentar el redirect de arriba):
     listen 443 ssl;
     ssl_certificate     /etc/letsencrypt/live/tu-dominio.com/fullchain.pem;
     ssl_certificate_key /etc/letsencrypt/live/tu-dominio.com/privkey.pem;
     include /etc/letsencrypt/options-ssl-nginx.conf;

    server_name _;

    # Tamaño máximo de archivos subidos
    client_max_body_size 20M;

    # ── API → Laravel PHP-FPM ───────────────────────────────────────────
    # Todas las rutas que empiezan con /api van al backend Laravel.
    # PHP-FPM tiene un único punto de entrada: public/index.php.
    location ^~ /api {
        fastcgi_pass            app:9000;
        fastcgi_read_timeout    300;

        # Le decimos a PHP-FPM qué archivo ejecutar y cuál es la ruta pedida
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param REQUEST_URI     $request_uri;

        include fastcgi_params;
    }

    # ── Frontend React (archivos estáticos del build) ───────────────────
    # React Router maneja la navegación del lado del cliente.
    # Si el archivo no existe como estático, devolvemos index.html para
    # que React Router resuelva la ruta.
    location / {
        root /var/www/frontend;
        try_files $uri $uri/ /index.html;

        # Assets con hash en el nombre (generados por Vite) son inmutables:
        # el browser puede cachearlos por 1 año sin problema.
        location ~* \.(js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico|webp)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
    }
}
